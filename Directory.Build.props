<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <Deterministic>true</Deterministic>
    <!-- The single source of the TravelRepo SDK version. Release tags are v$(Version). -->
    <Version>0.1.0</Version>
    <Authors>TravelRepo contributors</Authors>
    <!-- Public source repository, shown by clients such as Jourfold and used as NuGet package metadata. -->
    <RepositoryUrl></RepositoryUrl>
    <PackageProjectUrl>$(RepositoryUrl)</PackageProjectUrl>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="RepositoryUrl" Value="$(RepositoryUrl)" />
  </ItemGroup>
</Project>
