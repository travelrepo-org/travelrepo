{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "type": {
      "const": "budget"
    },
    "extensions": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": true
    },
    "title": {
      "type": "string"
    },
    "amount": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string",
          "pattern": "^-?\\d+(\\.\\d+)?$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      },
      "required": [
        "value",
        "currency"
      ],
      "additionalProperties": true
    },
    "scope": {
      "enum": [
        "trip",
        "category",
        "participant",
        "collection"
      ]
    }
  },
  "required": [
    "id",
    "type",
    "title",
    "amount"
  ],
  "additionalProperties": true,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://travelrepo.org/schema/1.0/budget.json"
}
