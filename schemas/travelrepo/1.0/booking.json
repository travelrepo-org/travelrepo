{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "type": {
      "const": "booking"
    },
    "extensions": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": true
    },
    "provider": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        }
      },
      "required": [],
      "additionalProperties": true
    },
    "reference": {
      "type": "string"
    },
    "status": {
      "enum": [
        "idea",
        "pending",
        "reserved",
        "confirmed",
        "cancelled",
        "completed"
      ]
    },
    "travelers": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
      }
    },
    "price": {
      "type": "object",
      "properties": {
        "value": {
          "type": "string",
          "pattern": "^-?\\d+(\\.\\d+)?$"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      },
      "required": [
        "value",
        "currency"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "id",
    "type"
  ],
  "additionalProperties": true,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://travelrepo.org/schema/1.0/booking.json"
}
