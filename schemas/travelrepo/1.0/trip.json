{
  "type": "object",
  "properties": {
    "schema": {
      "type": "object",
      "properties": {
        "name": {
          "const": "TravelRepo"
        },
        "version": {
          "const": "1.0"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": true
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string"
    },
    "dates": {
      "type": "object",
      "properties": {
        "start": {
          "type": [
            "string",
            "null"
          ]
        },
        "end": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [],
      "additionalProperties": true
    },
    "default_timezone": {
      "type": [
        "string",
        "null"
      ]
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
      }
    },
    "cover": {
      "type": "object",
      "properties": {
        "document": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
        }
      },
      "required": [
        "document"
      ],
      "additionalProperties": true
    },
    "variant": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
        },
        "title": {
          "type": "string"
        },
        "role": {
          "enum": [
            "primary",
            "variant"
          ]
        },
        "state": {
          "enum": [
            "active",
            "archived"
          ]
        },
        "parent": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "variant_id": {
                  "type": "string",
                  "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
                },
                "branch": {
                  "type": "string"
                },
                "commit": {
                  "type": "string"
                }
              },
              "required": [
                "variant_id",
                "branch",
                "commit"
              ],
              "additionalProperties": true
            }
          ]
        },
        "created_at": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "role",
        "state",
        "created_at"
      ],
      "additionalProperties": true
    },
    "extensions": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": true
    }
  },
  "required": [
    "schema",
    "id",
    "title",
    "language",
    "variant"
  ],
  "additionalProperties": true,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
