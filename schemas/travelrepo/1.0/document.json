{
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
    },
    "type": {
      "const": "document"
    },
    "extensions": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": true
    },
    "name": {
      "type": "string"
    },
    "media_type": {
      "type": "string"
    },
    "blob": {
      "type": "object",
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "encryption": {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": true
        }
      },
      "required": [
        "algorithm",
        "hash"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "id",
    "type",
    "name",
    "media_type",
    "blob"
  ],
  "additionalProperties": true,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://travelrepo.org/schema/1.0/document.json"
}
